{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^update_plan$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/gleap-hook.mjs\" plan --harness codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/gleap-hook.mjs\" stop --harness codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/gleap-hook.mjs\" session-start --harness codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
