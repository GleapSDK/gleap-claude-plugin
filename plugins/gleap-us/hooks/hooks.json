{
  "description": "Gleap: mirror the agent's plan and last message to the Gleap coding session, and drop the session file when Gleap says STOP (only when .gleap/session.json exists, i.e. for sessions started from Gleap).",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "TodoWrite|TaskCreate|TaskUpdate|.*update_plan",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/gleap-hook.mjs\" plan --harness claude-code",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*gleap.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/gleap-hook.mjs\" tool-result --harness claude-code",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/gleap-hook.mjs\" stop --harness claude-code",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/gleap-hook.mjs\" session-start --harness claude-code",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
